APP_ENV=local
ACCOUNT_GRPC_ADDR=account-service:9091
ROOM_GRPC_ADDR=room-service:9092
QUIZ_GRPC_ADDR=quiz-engine-service:9093
SCORING_GRPC_ADDR=scoring-service:9094
MATCHDATA_GRPC_ADDR=match-data-service:9095
MOCK_RSO_URL=http://mock-rso-service:8090
# Where the mock RSO may send the browser back to after sign-on: comma-separated, exact match.
MOCK_RSO_REDIRECT_URIS=http://localhost:3000/link/riot/callback,http://localhost:8080/api/link/riot/callback
# The mock RSO's test players. Empty means services/mock-rso-service/testplayers.json if you
# made one, otherwise the committed example.
MOCK_RSO_PLAYERS_FILE=
FRONTEND_ORIGIN=http://localhost:3000
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=friendlyfire
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_local_pw
POSTGRES_HOST_PORT=5432
HENRIKDEV_API_KEY=
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
# true: the frontend fakes the Gateway and plays a scripted room, so every screen works
# without the backend (FF-513). Only in `next dev`; production builds leave it out.
NEXT_PUBLIC_FAKE_BACKEND=false
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
AUTH0_AUDIENCE=https://api.friendlyfire.dev
AUTH0_ISSUER_URI=

